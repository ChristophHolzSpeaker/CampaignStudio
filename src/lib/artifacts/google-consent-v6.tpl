___SANDBOXED_JS_FOR_WEB_TEMPLATE___

const copyFromWindow = require('copyFromWindow');
const copyFromDataLayer = require('copyFromDataLayer');
const setDefaultConsentState = require('setDefaultConsentState');
const updateConsentState = require('updateConsentState');
const callInWindow = require('callInWindow');
const getType = require('getType');

// This container may also serve legacy pages. Only v6 owns this bridge.
if (copyFromWindow('__csConsentV6.version') !== 1) {
  data.gtmOnSuccess();
  return;
}
const event = copyFromDataLayer('event');
if (event === 'gtm.init_consent') {
  setDefaultConsentState({
    ad_storage: 'denied', analytics_storage: 'denied',
    ad_user_data: 'denied', ad_personalization: 'denied', wait_for_update: 500
  });
} else if (event !== 'cs_consent_update') {
  data.gtmOnSuccess();
  return;
}
// Read the latest complete snapshot, avoiding stale queued grants on withdrawal.
const snapshot = copyFromWindow('__csConsentV6.snapshot');
if (!snapshot || snapshot.version !== 1 || getType(snapshot.revision) !== 'number' || snapshot.revision < 1 || !snapshot.signals) {
  data.gtmOnFailure();
  return;
}
const signals = {};
const keys = ['ad_storage', 'analytics_storage', 'ad_user_data', 'ad_personalization'];
for (let i = 0; i < keys.length; i++) {
  const value = snapshot.signals[keys[i]];
  if (value !== 'granted' && value !== 'denied') {
    data.gtmOnFailure();
    return;
  }
  signals[keys[i]] = value;
}
// GTM prioritizes this update before subsequently queued measurement events.
updateConsentState(signals);
callInWindow('__csConsentV6.applied', snapshot.revision, signals);
data.gtmOnSuccess();

